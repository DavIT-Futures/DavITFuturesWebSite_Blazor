@page "/services"
@inherits SiteComponent

<PageTitle>@(Site.Language == "pl" ? "Usługi – DavIT Futures" : "Services – DavIT Futures")</PageTitle>

<div class="subpage-hero">
    <div class="container">
        <span class="subpage-eyebrow mono">@(Site.Language == "pl" ? "OFERTA & ARCHITEKTURA" : "SERVICES & ARCHITECTURE")</span>
        <h1 class="subpage-title">@Content!.Services.Title</h1>
        <p class="subpage-lead">@Content.Services.Subtitle</p>
    </div>
</div>

<ServicesSection ShowHeading="false" />

<ProcessSection />

<div class="container section-cta-wrap" style="margin-bottom: 56px;">
    <a class="btn btn-primary" href="contact">
        @(Site.Language == "pl" ? "Porozmawiajmy o Twoim projekcie" : "Let's talk about your project") <Icon Name="arrow" Size="16" />
    </a>
</div>
