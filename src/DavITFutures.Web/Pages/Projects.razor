@page "/projects"
@inherits SiteComponent

<PageTitle>@(Site.Language == "pl" ? "Projekty Komercyjne – DavIT Futures" : "Commercial Projects – DavIT Futures")</PageTitle>

<div class="subpage-hero">
    <div class="container">
        <span class="subpage-eyebrow mono">@(Site.Language == "pl" ? "PORTFOLIO & CASE STUDIES" : "COMMERCIAL PORTFOLIO")</span>
        <h1 class="subpage-title">@Content!.Projects.Title</h1>
        <p class="subpage-lead"><Rich Text="@Content.Projects.Subtitle" /></p>
    </div>
</div>

<div class="container projects-scope">
    <LogicAnalyzer ShowDecoder="false" ShowMeasurements="false" OnSelect="ScrollToProject" />
</div>

<ProjectsSection ShowHeading="false" />

<div class="container section-cta-wrap" style="margin-bottom: 56px;">
    <a class="btn btn-primary" href="contact">
        @(Site.Language == "pl" ? "Skonsultuj swój projekt" : "Discuss your project") <Icon Name="arrow" Size="16" />
    </a>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task ScrollToProject(int index) => await JS.InvokeVoidAsync("davit.scrollToId", $"project-{index}");
}
