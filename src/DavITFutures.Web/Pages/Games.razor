@page "/games"
@page "/retro-games"
@page "/games-remastering"
@inherits SiteComponent

<PageTitle>@(Site.Language == "pl" ? "Retro Games Remaster – Civ 1.5 Remastered – DavIT Futures" : "Retro Games Remaster – Civ 1.5 Remastered – DavIT Futures")</PageTitle>

@if (Content?.Games is not null)
{
    var g = Content.Games;
    var civ = g.Civ15;

    <!-- Subpage Hero (tighter, no subtitle) -->
    <div class="subpage-hero games-hero">
        <div class="container">
            <span class="subpage-eyebrow mono">
                <Icon Name="gamepad" Size="14" /> @g.Eyebrow
            </span>
            <h1 class="subpage-title">@g.Title</h1>
        </div>
    </div>

    <!-- Flagship: Civ 1.5 Remastered Hero Section -->
    <section class="section games-flagship-section">
        <div class="container">
            <div class="civ-hero-card">
                <!-- 1. Ekran startowy Civilization -->
                <div class="civ-title-banner media-preview-wrap" @onclick='() => OpenLightbox("img/games/civ1-title.png")' role="button" tabindex="0" title="@(Site.Language == "pl" ? "Kliknij, aby powiększyć w galerii" : "Click to view in full gallery")">
                    <img src="img/games/civ1-title.png" alt="Sid Meier's Civilization (1991) title screen" class="civ-banner-img" />
                    <span class="zoom-badge"><Icon Name="zoom" Size="14" /></span>
                </div>

                <!-- 2. Pod spodem: zwięzły opis, link do oficjalnej strony projektu i ikony Windows, Linux, Mac -->
                <div class="civ-hero-footer">
                    <div class="civ-hero-summary">
                        <div class="civ-headline-row">
                            <h2 class="civ-hero-title">@civ.Title</h2>
                            <div class="civ-platforms-inline">
                                <span class="os-badge win"><Icon Name="windows" Size="14" /> Windows</span>
                                <span class="os-badge linux"><Icon Name="linux" Size="14" /> Linux</span>
                                <span class="os-badge mac"><Icon Name="apple" Size="14" /> macOS</span>
                                <span class="os-badge native">⚡ @(Site.Language == "pl" ? "Zero DOSBox • Native C#" : "Zero DOSBox • Native C#")</span>
                            </div>
                        </div>
                        <p class="civ-short-desc">
                            @(Site.Language == "pl" 
                                ? "Otwarty remaster kultowej gry Civilization 1 (1991, DOS) przepisany od podstaw funkcja po funkcji do nowoczesnego C#. Gra działa natywnie na współczesnych systemach operacyjnych bez konieczności uruchamiania emulatora DOSBox, zachowując 100% oryginalnego klimatu i grafiki retro."
                                : "Open-source remaster of classic Civilization 1 (1991, DOS) rewritten function-by-function in clean C#. Runs natively on modern operating systems with zero DOSBox required, preserving 100% of authentic retro VGA graphics, sound, and gameplay.")
                        </p>
                    </div>

                    <div class="civ-hero-actions">
                        <a class="btn btn-primary btn-civ-website" href="@civ.WebsiteUrl" target="_blank" rel="noopener">
                            <Icon Name="web" Size="18" />
                            <span>@civ.WebsiteLabel</span>
                            <Icon Name="external" Size="14" />
                        </a>
                        <div class="civ-aux-actions">
                            <a class="btn btn-ghost btn-sm" href="@civ.GitHubUrl" target="_blank" rel="noopener">
                                <Icon Name="github" Size="16" /> @civ.GitHubLabel
                            </a>
                            <a class="btn btn-ghost btn-sm" href="@civ.ReleasesUrl" target="_blank" rel="noopener">
                                <Icon Name="download" Size="16" /> @civ.ReleasesLabel
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fan-Made DLC: Poland & Japan Showcase -->
            @if (g.Dlc is not null)
            {
                var dlc = g.Dlc;
                <div class="civ-dlc-card" id="dlc-poland-japan">
                    <div class="civ-dlc-header">
                        <span class="civ-badge dlc-badge-glow">@dlc.Badge</span>
                        <h2 class="civ-dlc-title">@dlc.Title</h2>
                    </div>

                    <!-- 1. Leader Portraits + Anthems side-by-side (portraits +40px, player vertical and compact) -->
                    <div class="civ-dlc-showcase">
                        <!-- Polska: Portret Kazimierza + Hymn obok w układzie pionowym -->
                        <div class="dlc-civ-card">
                            <figure class="dlc-civ-portrait">
                                <div class="media-preview-wrap" @onclick="() => OpenLightbox(dlc.CasimirImage)" role="button" tabindex="0" title="@(Site.Language == "pl" ? "Kliknij, aby powiększyć w galerii" : "Click to view in full gallery")">
                                    <img src="@dlc.CasimirImage" alt="@dlc.CasimirName" class="dlc-portrait-img" loading="lazy" />
                                    <span class="zoom-badge"><Icon Name="zoom" Size="14" /></span>
                                </div>
                                <figcaption class="dlc-photo-caption">@dlc.CasimirName</figcaption>
                            </figure>

                            <div class="dlc-civ-side">
                                <div class="dlc-anthem-meta">
                                    <span class="dlc-anthem-flag" aria-hidden="true">🇵🇱</span>
                                    <div class="dlc-anthem-text">
                                        <strong class="dlc-anthem-name">@dlc.PolandAnthemTitle</strong>
                                        <span class="dlc-anthem-sub">@dlc.PolandAnthemSubtitle</span>
                                    </div>
                                </div>
                                <div class="dlc-anthem-playback">
                                    <audio controls controlsList="nodownload noplaybackrate nofullscreen" preload="none" class="dlc-audio-player compact" src="@dlc.PolandAnthemAudio"></audio>
                                </div>
                            </div>
                        </div>

                        <!-- Japonia: Portret Tokugawy + Hymn obok w układzie pionowym -->
                        <div class="dlc-civ-card">
                            <figure class="dlc-civ-portrait">
                                <div class="media-preview-wrap" @onclick="() => OpenLightbox(dlc.TokugawaImage)" role="button" tabindex="0" title="@(Site.Language == "pl" ? "Kliknij, aby powiększyć w galerii" : "Click to view in full gallery")">
                                    <img src="@dlc.TokugawaImage" alt="@dlc.TokugawaName" class="dlc-portrait-img" loading="lazy" />
                                    <span class="zoom-badge"><Icon Name="zoom" Size="14" /></span>
                                </div>
                                <figcaption class="dlc-photo-caption">@dlc.TokugawaName</figcaption>
                            </figure>

                            <div class="dlc-civ-side">
                                <div class="dlc-anthem-meta">
                                    <span class="dlc-anthem-flag" aria-hidden="true">🇯🇵</span>
                                    <div class="dlc-anthem-text">
                                        <strong class="dlc-anthem-name">@dlc.JapanAnthemTitle</strong>
                                        <span class="dlc-anthem-sub">@dlc.JapanAnthemSubtitle</span>
                                    </div>
                                </div>
                                <div class="dlc-anthem-playback">
                                    <audio controls controlsList="nodownload noplaybackrate nofullscreen" preload="none" class="dlc-audio-player compact" src="@dlc.JapanAnthemAudio"></audio>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Four Highlights in ONE single row -->
                    <div class="civ-dlc-highlights-row">
                        @foreach (var hl in dlc.Highlights)
                        {
                            var parts = hl.Split(':', 2);
                            <div class="civ-dlc-highlight-card">
                                <div class="highlight-title">
                                    <Icon Name="spark" Size="14" />
                                    <span>@parts[0].Trim()</span>
                                </div>
                                @if (parts.Length > 1)
                                {
                                    <p class="highlight-desc">@parts[1].Trim()</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- What's New Section -->
    <section class="section section-alt" id="whats-new">
        <div class="container">
            <SectionHeading Title="@g.WhatsNewTitle" Subtitle="@g.WhatsNewSubtitle" />

            <div class="whats-new-grid">
                @foreach (var item in g.Features)
                {
                    var mediaClass = !string.IsNullOrEmpty(item.ThirdImage) 
                        ? "has-three" 
                        : (!string.IsNullOrEmpty(item.SecondImage) ? "has-two" : "");

                    <article class="whats-new-card" id="@item.Id">
                        <div class="card-media @mediaClass">
                            <div class="media-preview-wrap" @onclick="() => OpenLightbox(item.Image)" role="button" tabindex="0" title="@(Site.Language == "pl" ? "Kliknij, aby powiększyć w galerii" : "Click to view in full gallery")">
                                <img src="@item.Image" alt="@item.Title" class="feature-img" loading="lazy" />
                                <span class="zoom-badge"><Icon Name="zoom" Size="14" /></span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.SecondImage))
                            {
                                <div class="media-preview-wrap" @onclick="() => OpenLightbox(item.SecondImage)" role="button" tabindex="0" title="@(Site.Language == "pl" ? "Kliknij, aby powiększyć w galerii" : "Click to view in full gallery")">
                                    <img src="@item.SecondImage" alt="@item.Title - szczegóły" class="feature-img secondary-img" loading="lazy" />
                                    <span class="zoom-badge"><Icon Name="zoom" Size="14" /></span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(item.ThirdImage))
                            {
                                <div class="media-preview-wrap" @onclick="() => OpenLightbox(item.ThirdImage)" role="button" tabindex="0" title="@(Site.Language == "pl" ? "Kliknij, aby powiększyć w galerii" : "Click to view in full gallery")">
                                    <img src="@item.ThirdImage" alt="@item.Title - walka" class="feature-img tertiary-img" loading="lazy" />
                                    <span class="zoom-badge"><Icon Name="zoom" Size="14" /></span>
                                </div>
                            }
                        </div>

                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(item.Badge))
                            {
                                <span class="feature-badge">@item.Badge</span>
                            }
                            <h3 class="feature-title">@item.Title</h3>
                            <p class="feature-desc">@item.Description</p>

                            @if (!string.IsNullOrEmpty(item.Caption))
                            {
                                <p class="feature-caption">
                                    <Icon Name="file" Size="14" /> @item.Caption
                                </p>
                            }
                        </div>
                    </article>
                }
            </div>

            <!-- How to Play Strip -->
            <div class="civ-play-strip" style="margin-top: 48px;">
                <div class="civ-play-content">
                    <h3 class="civ-play-title">
                        <Icon Name="spark" Size="18" /> @civ.PlayInstructionsTitle
                    </h3>
                    <ol class="civ-play-steps">
                        @foreach (var step in civ.PlaySteps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                </div>
                <div class="civ-play-media media-preview-wrap" @onclick='() => OpenLightbox("img/games/game-folder.png")' role="button" tabindex="0" title="@(Site.Language == "pl" ? "Kliknij, aby powiększyć w galerii" : "Click to view in full gallery")">
                    <img src="img/games/game-folder.png" alt="Civilization game folder structure" class="civ-folder-img" loading="lazy" />
                    <span class="zoom-badge"><Icon Name="zoom" Size="14" /></span>
                </div>
            </div>

            <!-- Call to Action Banner -->
            <div class="civ-cta-banner">
                <div class="civ-cta-text">
                    <h3>@(Site.Language == "pl" ? "Chcesz wypróbować Civ 1.5 Remastered lub przejrzeć kod?" : "Ready to play Civ 1.5 Remastered or explore the source code?")</h3>
                    <p>@(Site.Language == "pl" ? "Kod projektu jest w 100% open-source pod licencją MIT na GitHubie. Działa bez DOSBoksa na Windowsie, Linuksie i macOS." : "100% open-source project under MIT license on GitHub. Zero DOSBox required, runs cross-platform.")</p>
                </div>
                <div class="civ-cta-actions">
                    <a class="btn btn-primary" href="@civ.WebsiteUrl" target="_blank" rel="noopener">
                        <Icon Name="web" Size="18" /> @(Site.Language == "pl" ? "Oficjalna strona Civ 1.5" : "Official Civ 1.5 Website")
                    </a>
                    <a class="btn btn-ghost" href="@civ.GitHubUrl" target="_blank" rel="noopener">
                        <Icon Name="github" Size="18" /> @(Site.Language == "pl" ? "Repozytorium GitHub" : "GitHub Repository")
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Other Remasters: Australia 1859 Sim -->
    @if (g.Australia1859 is not null)
    {
        var aus = g.Australia1859;
        <section class="section" id="australia-sim">
            <div class="container">
                <div class="other-remaster-card">
                    <div class="other-remaster-header">
                        <div>
                            <span class="other-badge">@aus.Badge</span>
                            <h3 class="other-title">@aus.Title</h3>
                        </div>
                        <a class="btn btn-ghost" href="@aus.Url" target="_blank" rel="noopener">
                            <Icon Name="github" Size="16" /> @aus.UrlLabel
                        </a>
                    </div>

                    <!-- Platform Badges for Australia Sim -->
                    <div class="civ-platforms-inline" style="margin: 12px 0 16px;">
                        <span class="os-badge win"><Icon Name="windows" Size="14" /> Windows</span>
                        <span class="os-badge linux"><Icon Name="linux" Size="14" /> Linux</span>
                        <span class="os-badge mac"><Icon Name="apple" Size="14" /> macOS</span>
                        <span class="os-badge">C++20</span>
                        <span class="os-badge">Raylib 5.5</span>
                    </div>

                    <p class="other-desc">@aus.Description</p>

                    @if (aus.Screenshots is not null && aus.Screenshots.Count > 0)
                    {
                        <!-- 2x2 Grid for Australia Sim screenshots (twice as large) -->
                        <div class="australia-screens-grid">
                            @foreach (var sc in aus.Screenshots)
                            {
                                <figure class="australia-screen-card">
                                    <div class="media-preview-wrap" @onclick="() => OpenLightbox(sc.Image)" role="button" tabindex="0" title="@(Site.Language == "pl" ? "Kliknij, aby powiększyć w galerii" : "Click to view in full gallery")">
                                        <img src="@sc.Image" alt="@sc.Title" class="australia-thumb-img" loading="lazy" />
                                        <span class="zoom-badge"><Icon Name="zoom" Size="14" /></span>
                                    </div>
                                    <figcaption class="australia-screen-caption">
                                        <strong class="australia-caption-title">@sc.Title</strong>
                                        <span class="australia-caption-text">@sc.Caption</span>
                                    </figcaption>
                                </figure>
                            }
                        </div>
                    }

                    <ul class="chips small" style="margin-top: 24px;">
                        @foreach (var tag in aus.Tags)
                        {
                            <li>@tag</li>
                        }
                    </ul>
                </div>
            </div>
        </section>
    }

    <!-- Lightbox Gallery Modal -->
    <ImageLightbox IsOpen="_lightboxOpen" 
                   Images="_lightboxItems" 
                   CurrentIndex="_lightboxIndex" 
                   OnClose="CloseLightbox" 
                   OnIndexChanged="SetLightboxIndex" />
}

@code {
    private bool _lightboxOpen;
    private int _lightboxIndex;
    private List<LightboxItem> _lightboxItems = new();

    protected override void OnParametersSet()
    {
        BuildLightboxItems();
    }

    private void BuildLightboxItems()
    {
        _lightboxItems.Clear();
        if (Content?.Games is null) return;

        _lightboxItems.Add(new LightboxItem(
            "img/games/civ1-title.png",
            "Sid Meier's Civilization (1991)",
            Site.Language == "pl"
                ? "Klasyczny ekran tytułowy Civilization 1 (DOS, 1991) – punkt wyjścia dla C# remastera."
                : "Classic Civilization 1 (DOS, 1991) title screen – the starting point of the C# remaster."));

        if (Content.Games.Dlc is not null)
        {
            var dlc = Content.Games.Dlc;
            _lightboxItems.Add(new LightboxItem(
                dlc.CasimirImage,
                dlc.CasimirName,
                dlc.CasimirCaption));
            _lightboxItems.Add(new LightboxItem(
                dlc.TokugawaImage,
                dlc.TokugawaName,
                dlc.TokugawaCaption));
        }

        foreach (var feat in Content.Games.Features)
        {
            if (!string.IsNullOrEmpty(feat.Image))
            {
                _lightboxItems.Add(new LightboxItem(
                    feat.Image,
                    feat.Title,
                    feat.Caption ?? feat.Description));
            }
            if (!string.IsNullOrEmpty(feat.SecondImage))
            {
                _lightboxItems.Add(new LightboxItem(
                    feat.SecondImage,
                    $"{feat.Title} – {(Site.Language == "pl" ? "Widok szczegółowy" : "Detailed view")}",
                    feat.Caption));
            }
            if (!string.IsNullOrEmpty(feat.ThirdImage))
            {
                _lightboxItems.Add(new LightboxItem(
                    feat.ThirdImage,
                    $"{feat.Title} – {(Site.Language == "pl" ? "Zbliżenie taktyczne" : "Tactical view")}",
                    feat.Caption));
            }
        }

        if (Content.Games.Civ15 is not null)
        {
            _lightboxItems.Add(new LightboxItem(
                "img/games/game-folder.png",
                Content.Games.Civ15.PlayInstructionsTitle,
                Site.Language == "pl"
                    ? "Struktura folderu gry i uruchomienie Civ 1.5 Remastered obok oryginalnych plików Civilization 1 (1991)."
                    : "Civilization game folder structure and Civ 1.5 executable setup."));
        }

        if (Content.Games.Australia1859?.Screenshots is not null)
        {
            foreach (var sc in Content.Games.Australia1859.Screenshots)
            {
                _lightboxItems.Add(new LightboxItem(
                    sc.Image,
                    sc.Title,
                    sc.Caption));
            }
        }
    }

    private void OpenLightbox(string imageUrl)
    {
        var idx = _lightboxItems.FindIndex(x => x.Url == imageUrl);
        if (idx >= 0)
        {
            _lightboxIndex = idx;
            _lightboxOpen = true;
        }
    }

    private void CloseLightbox()
    {
        _lightboxOpen = false;
    }

    private void SetLightboxIndex(int idx)
    {
        _lightboxIndex = idx;
    }
}
