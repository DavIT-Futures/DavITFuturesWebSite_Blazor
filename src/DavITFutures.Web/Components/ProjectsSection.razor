@inherits SiteComponent

<section class="section" id="projects">
    <div class="container">
        @if (ShowHeading)
        {
            <SectionHeading Title="@Content!.Projects.Title" Subtitle="@Content.Projects.Subtitle" />
        }

        <div class="cards projects">
            @foreach (var p in Content!.Projects.Items)
            {
                <article class="card project-card">
                    <div class="project-top">
                        <span class="project-client">@p.Client</span>
                        <span class="project-years">@p.Years</span>
                    </div>
                    <h3>@p.Name</h3>
                    @if (!string.IsNullOrEmpty(p.Outcome))
                    {
                        <div class="project-outcome">@p.Outcome</div>
                    }
                    <p>@p.Description</p>
                    <div class="chips">
                        @foreach (var tag in p.Tags)
                        {
                            <span class="chip">@tag</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(p.Url))
                    {
                        <a class="project-link" href="@p.Url" target="_blank" rel="noopener">
                            @Content.Projects.CodeLabel <Icon Name="arrow" Size="16" />
                        </a>
                    }
                </article>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public bool ShowHeading { get; set; } = true;
}
