@inherits SiteComponent
@inject NavigationManager Nav

<header class="site-header">
    <div class="container header-inner">
        <a class="logo" href="" @onclick="CloseMenu">
            <span class="logo-mark">D</span>
            <span class="logo-text">DavIT<b>Futures</b></span>
        </a>

        <nav class="nav @(_menuOpen ? "is-open" : "")" aria-label="Menu">
            <NavLink class="nav-link" href="services" @onclick="CloseMenu">@Content!.Nav.Services</NavLink>
            <NavLink class="nav-link" href="projects" @onclick="CloseMenu">@Content!.Nav.Projects</NavLink>
            <NavLink class="nav-link" href="github" @onclick="CloseMenu">@Content!.Nav.GitHub</NavLink>
            <NavLink class="nav-link" href="technology" @onclick="CloseMenu">@Content!.Nav.Tech</NavLink>
            <NavLink class="nav-link" href="cv" @onclick="CloseMenu">@Content!.Nav.Cv</NavLink>
            <NavLink class="@GetContactNavLinkClass()" href="contact" @onclick="CloseMenu">@Content!.Nav.Contact</NavLink>
            <NavLink class="nav-link" href="about" @onclick="CloseMenu">@Content!.Nav.About</NavLink>
        </nav>

        <div class="header-actions">
            <div class="lang-switch" role="group" aria-label="@Content!.Nav.Language">
                @foreach (var lang in SiteState.Languages)
                {
                    <button type="button" class="@(Site.Language == lang ? "active" : "")"
                            aria-pressed="@(Site.Language == lang)"
                            @onclick="() => Site.SetLanguageAsync(lang)">@lang.ToUpperInvariant()</button>
                }
            </div>
            <button type="button" class="icon-btn" @onclick="Site.ToggleThemeAsync"
                    title="@(Site.Theme == "dark" ? Content!.Nav.ThemeLight : Content!.Nav.ThemeDark)"
                    aria-label="@(Site.Theme == "dark" ? Content!.Nav.ThemeLight : Content!.Nav.ThemeDark)">
                <Icon Name="@(Site.Theme == "dark" ? "sun" : "moon")" Size="20" />
            </button>
            <button type="button" class="icon-btn menu-btn" aria-label="Menu" aria-expanded="@_menuOpen"
                    @onclick="() => _menuOpen = !_menuOpen">
                <Icon Name="@(_menuOpen ? "close" : "menu")" Size="22" />
            </button>
        </div>
    </div>
</header>

@code {
    private bool _menuOpen;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private string GetContactNavLinkClass()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        return relative.StartsWith("Home/Contact", StringComparison.OrdinalIgnoreCase)
            ? "nav-link active"
            : "nav-link";
    }

    private void CloseMenu() => _menuOpen = false;

    public override void Dispose()
    {
        base.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }
}
