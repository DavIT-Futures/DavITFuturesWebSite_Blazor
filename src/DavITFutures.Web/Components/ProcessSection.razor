@inherits SiteComponent

<section class="section" id="how">
    <div class="container">
        <SectionHeading Title="@Content!.Process.Title" Subtitle="@Content.Process.Subtitle" />

        <div class="pipeline-track">
            @foreach (var (step, i) in Content.Process.Steps.Select((s, i) => (s, i)))
            {
                <div class="track-step">
                    <div class="step-marker">
                        <span class="step-circle mono">@($"0{i + 1}")</span>
                        <span class="step-line" aria-hidden="true"></span>
                    </div>
                    <div class="step-content">
                        <span class="step-tag mono">@($"PHASE 0{i + 1}")</span>
                        <h3 class="step-title">@step.Title</h3>
                        <p class="step-desc">@step.Text</p>
                    </div>
                </div>
            }
        </div>

        <div class="pipeline-footnote">
            <span class="footnote-tag mono">ASSURANCE</span>
            <span class="footnote-text">@Content.Process.Footnote</span>
        </div>
    </div>
</section>
