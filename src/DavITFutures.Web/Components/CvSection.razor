@inherits SiteComponent
@inject NavigationManager Nav

<section class="section" id="cv">
    <div class="container">
        @if (ShowHeading)
        {
            <SectionHeading Title="@Content!.Cv.Title" Subtitle="@Content.Cv.Subtitle" />
        }
        <div class="cards cv-cards">
            @foreach (var cv in Content!.Cv.Versions)
            {
                <article class="card cv-card">
                    <div class="card-icon"><Icon Name="file" /></div>
                    <div class="cv-meta">@cv.Pages</div>
                    <h3>@cv.Title</h3>
                    <p>@cv.Text</p>
                    @if (string.IsNullOrEmpty(cv.Url))
                    {
                        <span class="btn btn-ghost disabled" aria-disabled="true">@(Site.Language == "pl" ? "Wkrótce" : "Coming soon")</span>
                    }
                    else
                    {
                        <div class="cv-actions">
                            <a class="btn btn-primary" href="@cv.Url" @onclick="() => OpenCv(cv.Url)" @onclick:preventDefault>@cv.ButtonLabel <Icon Name="arrow" Size="18" /></a>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public bool ShowHeading { get; set; } = true;

    private void OpenCv(string url)
    {
        Nav.NavigateTo(url, forceLoad: true);
    }
}
