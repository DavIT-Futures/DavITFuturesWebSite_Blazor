@inherits SiteComponent

<section class="hero" id="top">
    <div class="container hero-inner">
        <div class="hero-grid">
            <div class="hero-content">
                <div class="status-badge">
                    <span class="status-dot"></span>
                    <span class="status-text">@(Site.Language == "pl" ? "Dostępny na nowe projekty i doradztwo" : "Available for architecture & engineering")</span>
                </div>
                <h1>
                    @Content!.Hero.Title
                    <span class="hero-highlight">@Content.Hero.Highlight</span>
                </h1>
                <p class="lead">@Content.Hero.Lead</p>
                <div class="hero-cta">
                    <a class="btn btn-primary" href="@Content.Hero.PrimaryCta.Url">@Content.Hero.PrimaryCta.Label <Icon Name="arrow" Size="16" /></a>
                    <a class="btn btn-ghost" href="@Content.Hero.SecondaryCta.Url">@Content.Hero.SecondaryCta.Label</a>
                </div>
            </div>

            <div class="hero-aside">
                <div class="tech-spec-card">
                    <div class="spec-header">
                        <span class="spec-terminal-dots">
                            <span class="dot red"></span>
                            <span class="dot yellow"></span>
                            <span class="dot green"></span>
                        </span>
                        <span class="spec-title">ENGINEERING SPEC // 2026</span>
                        <span class="spec-status">PRODUCTION</span>
                    </div>
                    <div class="spec-body">
                        <div class="spec-row">
                            <span class="spec-label">DOMAIN</span>
                            <span class="spec-value">FinTech · Quantitative Trading · SaaS</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">BACKEND &amp; CORE</span>
                            <span class="spec-value mono">.NET 10 · C# 14 · REST &amp; GraphQL · Microservices</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">WEB FRONTENDS</span>
                            <span class="spec-value mono">Angular · React · Vue · Blazor · TypeScript</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">DEVOPS &amp; DATA</span>
                            <span class="spec-value mono">GitLab CI/CD · GitHub Actions · Docker · MS SQL · Postgres</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">STANDARDS</span>
                            <span class="spec-value highlight">Automated regression tests · Bank-grade security</span>
                        </div>
                        <div class="spec-footer">
                            <div class="spec-stat">
                                <span class="spec-stat-num mono">18+</span>
                                <span class="spec-stat-desc">@(Site.Language == "pl" ? "lat w inżynierii" : "years in engineering")</span>
                            </div>
                            <div class="spec-stat">
                                <span class="spec-stat-num mono">£15M</span>
                                <span class="spec-stat-desc">@(Site.Language == "pl" ? "zysk L2 Dealer (1 m-c)" : "L2 Dealer P&L (1st mo)")</span>
                            </div>
                            <div class="spec-stat">
                                <span class="spec-stat-num mono">70%</span>
                                <span class="spec-stat-desc">@(Site.Language == "pl" ? "rynku funduszy w PL" : "PL fund market share")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Content.Hero.ClientBrands is { Count: > 0 } || Content.Hero.Clients is { Count: > 0 })
        {
            <div class="hero-clients-showcase">
                <div class="clients-showcase-header">
                    <span class="clients-label">@Content.Hero.ClientsLabel</span>
                </div>
                <div class="clients-cards">
                    @foreach (var brand in GetClientBrands())
                    {
                        <a class="client-card" href="projects" title="@(Site.Language == "pl" ? $"Zobacz projekty: {brand.Name}" : $"View projects: {brand.Name}")">
                            <div class="client-logo-box">
                                <img src="@brand.Logo" alt="@brand.Name logo" class="client-logo-img" loading="lazy" />
                            </div>
                            <span class="client-caption">@brand.Name</span>
                        </a>
                    }
                </div>
            </div>
        }

        <div class="stats-strip">
            @foreach (var stat in Content.Hero.Stats)
            {
                <div class="strip-item">
                    <span class="strip-value mono">@stat.Value</span>
                    <span class="strip-label">@stat.Label</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private IEnumerable<(string Name, string Logo)> GetClientBrands()
    {
        if (Content?.Hero.ClientBrands is { Count: > 0 })
        {
            foreach (var b in Content.Hero.ClientBrands)
            {
                yield return (b.Name, b.Logo);
            }
            yield break;
        }

        if (Content?.Hero.Clients is not null)
        {
            foreach (var c in Content.Hero.Clients)
            {
                var logo = c switch
                {
                    "IG Group" => "img/clients/ig-group.svg",
                    "Credit Suisse" => "img/clients/credit-suisse.svg",
                    "Qiagen" => "img/clients/qiagen.svg",
                    "Vitalograph" => "img/clients/vitalograph.svg",
                    "AMCS Group" => "img/clients/amcs-group.svg",
                    "Tyrecheck" => "img/clients/tyrecheck.svg",
                    _ => ""
                };
                yield return (c, logo);
            }
        }
    }
}
