@inherits SiteComponent

<section class="section tech-console-section" id="tech">
    <div class="container">
        @if (ShowHeading)
        {
            <SectionHeading Title="@Content!.Tech.Title" Subtitle="@Content.Tech.Subtitle" />
        }

        <div class="linux-terminal">
            <!-- Pasek okna terminala -->
            <div class="terminal-titlebar">
                <div class="terminal-controls" aria-hidden="true">
                    <span class="control-dot close"></span>
                    <span class="control-dot minimize"></span>
                    <span class="control-dot maximize"></span>
                </div>
                <div class="terminal-title mono">
                    <span class="prompt-user">davit@futures</span>:<span class="prompt-path">~/technology-stack</span>
                </div>
                <div class="terminal-badges mono">
                    <span class="term-badge"><span class="badge-dot-live"></span> ONLINE</span>
                    <span class="term-badge">18+ YRS</span>
                </div>
            </div>

            <!-- Zakładki kategorii -->
            <div class="terminal-tmux-bar mono">
                <button type="button" class="tmux-tab @(selectedGroup == null ? "active" : "")" @onclick="() => SelectGroup(null)">
                    @(Site.Language == "pl" ? "Wszystkie" : "All")
                </button>
                @if (Content?.Tech?.Groups is not null)
                {
                    foreach (var g in Content.Tech.Groups)
                    {
                        <button type="button" class="tmux-tab @(selectedGroup == g.Name ? "active" : "")" @onclick="() => SelectGroup(g.Name)">
                            @GetTabLabel(g.Name)
                        </button>
                    }
                }
            </div>

            <!-- Treść konsoli -->
            <div class="terminal-body">
                <div class="terminal-modules">
                    @foreach (var group in GetVisibleGroups())
                    {
                        var isAi = group.Name.Contains("AI", StringComparison.OrdinalIgnoreCase);
                        <div class="terminal-module-block @(isAi ? "is-ai-module" : "")">
                            <div class="module-header">
                                <h3 class="module-name mono">@group.Name</h3>
                                <span class="module-count mono">@group.Items.Count @(Site.Language == "pl" ? "technologii" : "technologies")</span>
                            </div>

                            <div class="module-packages-grid">
                                @foreach (var item in group.Items)
                                {
                                    <div class="package-pill mono">
                                        <span class="pkg-icon">✓</span>
                                        <span class="pkg-title">@item</span>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(group.Note))
                            {
                                <div class="terminal-hud-box">
                                    <div class="hud-header mono">
                                        <span class="hud-tag">TELEMETRY // IG GROUP</span>
                                        <span class="hud-client">AUTONOMOUS SOFTWARE FACTORY</span>
                                    </div>
                                    <div class="hud-stats-grid mono">
                                        <div class="hud-stat-cell">
                                            <span class="hud-stat-val">4.0×</span>
                                            <span class="hud-stat-lbl">@(Site.Language == "pl" ? "Wydajność zespołu" : "Team velocity")</span>
                                        </div>
                                        <div class="hud-stat-cell">
                                            <span class="hud-stat-val">0.9d</span>
                                            <span class="hud-stat-lbl">@(Site.Language == "pl" ? "Czas do merge'a (z 5.4d)" : "Cycle time (vs 5.4d)")</span>
                                        </div>
                                        <div class="hud-stat-cell">
                                            <span class="hud-stat-val">16 PRs</span>
                                            <span class="hud-stat-lbl">@(Site.Language == "pl" ? "Zamykanych w nocy" : "Closed overnight")</span>
                                        </div>
                                        <div class="hud-stat-cell">
                                            <span class="hud-stat-val">100%</span>
                                            <span class="hud-stat-lbl">@(Site.Language == "pl" ? "Nadzór człowieka" : "Human reviewed")</span>
                                        </div>
                                    </div>
                                    <p class="hud-note-text">@group.Note</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public bool ShowHeading { get; set; } = true;

    private string? selectedGroup = null;

    private void SelectGroup(string? group)
    {
        selectedGroup = group;
    }

    private IEnumerable<TechGroup> GetVisibleGroups()
    {
        if (Content?.Tech?.Groups is null) return Enumerable.Empty<TechGroup>();
        if (string.IsNullOrEmpty(selectedGroup)) return Content.Tech.Groups;
        return Content.Tech.Groups.Where(g => g.Name.Equals(selectedGroup, StringComparison.OrdinalIgnoreCase));
    }

    private string GetTabLabel(string name)
    {
        if (name.Contains("Frontend", StringComparison.OrdinalIgnoreCase))
            return "Frontend & Mobile";
        if (name.Contains("DevOps", StringComparison.OrdinalIgnoreCase))
            return Site.Language == "pl" ? "DevOps & Chmura" : "DevOps & Cloud";
        if (name.Contains("Jakość", StringComparison.OrdinalIgnoreCase) || name.Contains("Quality", StringComparison.OrdinalIgnoreCase))
            return Site.Language == "pl" ? "Jakość" : "Quality";
        if (name.Equals("AI", StringComparison.OrdinalIgnoreCase))
            return Site.Language == "pl" ? "AI & Agenci" : "AI & Agents";
        return name;
    }
}
