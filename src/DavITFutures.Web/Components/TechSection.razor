@inherits SiteComponent

<section class="section tech-console-section" id="tech">
    <div class="container">
        @if (ShowHeading)
        {
            <SectionHeading Title="@Content!.Tech.Title" Subtitle="@Content.Tech.Subtitle" />
        }

        <div class="linux-terminal">
            <!-- Pasek okna terminala -->
            <div class="terminal-titlebar">
                <div class="terminal-controls" aria-hidden="true">
                    <span class="control-dot close"></span>
                    <span class="control-dot minimize"></span>
                    <span class="control-dot maximize"></span>
                </div>
                <div class="terminal-title mono">
                    <span class="prompt-user">davit@futures</span>:<span class="prompt-path">~/stack/production</span> (zsh)
                </div>
                <div class="terminal-badges mono">
                    <span class="term-badge"><span class="badge-dot-live"></span> ONLINE</span>
                    <span class="term-badge">18+ YRS</span>
                </div>
            </div>

            <!-- Pasek tmux / zakładek kategorii -->
            <div class="terminal-tmux-bar mono">
                <button type="button" class="tmux-tab @(selectedGroup == null ? "active" : "")" @onclick="() => SelectGroup(null)">
                    <span class="tmux-num">[0]</span> ALL_MODULES
                </button>
                @if (Content?.Tech?.Groups is not null)
                {
                    for (int i = 0; i < Content.Tech.Groups.Count; i++)
                    {
                        var g = Content.Tech.Groups[i];
                        var idx = i + 1;
                        <button type="button" class="tmux-tab @(selectedGroup == g.Name ? "active" : "")" @onclick="() => SelectGroup(g.Name)">
                            <span class="tmux-num">[@idx]</span> @GetShortGroupName(g.Name)
                        </button>
                    }
                }
            </div>

            <!-- Wnętrze konsoli -->
            <div class="terminal-body mono">
                <div class="terminal-intro">
                    <div class="terminal-cmd-line">
                        <span class="terminal-prompt">davit@futures:~$</span>
                        <span class="terminal-cmd">./inspect-stack.sh --status=verified --env=enterprise</span>
                    </div>
                    <div class="terminal-system-info">
                        <span class="sys-ok">[OK]</span> <span class="sys-text">Runtime verified // 5 subsystem clusters // 46 active enterprise packages</span>
                    </div>
                </div>

                <div class="terminal-modules">
                    @foreach (var group in GetVisibleGroups())
                    {
                        var isAi = group.Name.Contains("AI", StringComparison.OrdinalIgnoreCase);
                        <div class="terminal-module-block @(isAi ? "is-ai-module" : "")">
                            <div class="module-header">
                                <span class="module-cmd">$ sys.load --cluster="@GetClusterKey(group.Name)"</span>
                                <div class="module-title-wrap">
                                    <span class="module-status-flag">[ACTIVE]</span>
                                    <h3 class="module-name">@group.Name</h3>
                                    <span class="module-count">(@group.Items.Count packages)</span>
                                </div>
                            </div>

                            <div class="module-packages-grid">
                                @foreach (var item in group.Items)
                                {
                                    <div class="package-pill">
                                        <span class="pkg-icon">[✓]</span>
                                        <span class="pkg-title">@item</span>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(group.Note))
                            {
                                <div class="terminal-hud-box">
                                    <div class="hud-header">
                                        <span class="hud-tag">TELEMETRY // REAL-WORLD AGENTIC IMPACT</span>
                                        <span class="hud-client">CLIENT: IG GROUP</span>
                                    </div>
                                    <div class="hud-stats-grid">
                                        <div class="hud-stat-cell">
                                            <span class="hud-stat-val">4.0×</span>
                                            <span class="hud-stat-lbl">@(Site.Language == "pl" ? "Średnia wydajność zespołu" : "Team velocity ratio")</span>
                                        </div>
                                        <div class="hud-stat-cell">
                                            <span class="hud-stat-val">0.9d</span>
                                            <span class="hud-stat-lbl">@(Site.Language == "pl" ? "Czas do merge'a (z 5.4d)" : "Cycle time (vs 5.4d)")</span>
                                        </div>
                                        <div class="hud-stat-cell">
                                            <span class="hud-stat-val">16 PRs</span>
                                            <span class="hud-stat-lbl">@(Site.Language == "pl" ? "Zamykanych w nocy przez agentów" : "Resolved overnight by agents")</span>
                                        </div>
                                        <div class="hud-stat-cell">
                                            <span class="hud-stat-val">100%</span>
                                            <span class="hud-stat-lbl">@(Site.Language == "pl" ? "Przetestowane i przejrzane" : "Human review & test verified")</span>
                                        </div>
                                    </div>
                                    <p class="hud-note-text">@group.Note</p>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="terminal-footer-line">
                    <div class="terminal-cmd-line">
                        <span class="terminal-prompt">davit@futures:~$</span>
                        <span class="terminal-cmd">cat /etc/standards/manifest</span>
                    </div>
                    <div class="terminal-output-quote">
                        @(Site.Language == "pl" 
                            ? ">> Standardy: Zautomatyzowane testy regresyjne, zero długu technologicznego, bankowe rygory bezpieczeństwa." 
                            : ">> Standards: Automated regression tests, zero tech debt, bank-grade security & clean architecture.")
                    </div>
                    <div class="terminal-prompt-end">
                        <span class="terminal-prompt">davit@futures:~$</span>
                        <span class="matrix-cursor">█</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public bool ShowHeading { get; set; } = true;

    private string? selectedGroup = null;

    private void SelectGroup(string? group)
    {
        selectedGroup = group;
    }

    private IEnumerable<TechGroup> GetVisibleGroups()
    {
        if (Content?.Tech?.Groups is null) return Enumerable.Empty<TechGroup>();
        if (string.IsNullOrEmpty(selectedGroup)) return Content.Tech.Groups;
        return Content.Tech.Groups.Where(g => g.Name.Equals(selectedGroup, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetShortGroupName(string name) => name switch
    {
        "Backend" => "BACKEND.SYS",
        "Frontend, desktop i mobile" or "Frontend, desktop and mobile" => "FRONTENDS.UI",
        "DevOps i chmura" or "DevOps and cloud" => "DEVOPS.INFRA",
        "Jakość" or "Quality" => "QUALITY.QA",
        "AI" => "AI_FACTORY.AGENTS",
        _ => name.ToUpperInvariant()
    };

    private static string GetClusterKey(string name) => name switch
    {
        "Backend" => "core.backend",
        "Frontend, desktop i mobile" or "Frontend, desktop and mobile" => "client.frontends",
        "DevOps i chmura" or "DevOps and cloud" => "infra.devops",
        "Jakość" or "Quality" => "standards.qa",
        "AI" => "agentic.mesh",
        _ => "system"
    };
}
