@inherits SiteComponent

<section class="section section-alt" id="tech">
    <div class="container">
        @if (ShowHeading)
        {
            <SectionHeading Title="@Content!.Tech.Title" Subtitle="@Content.Tech.Subtitle" />
        }
        <div class="tech-grid">
            @foreach (var group in Content!.Tech.Groups)
            {
                <div class="tech-group @(string.IsNullOrEmpty(group.Note) ? "" : "wide")">
                    <h3>@group.Name</h3>
                    <ul class="chips">
                        @foreach (var item in group.Items)
                        {
                            <li>@item</li>
                        }
                    </ul>
                    @if (!string.IsNullOrEmpty(group.Note))
                    {
                        <p class="tech-note">@group.Note</p>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public bool ShowHeading { get; set; } = true;
}
